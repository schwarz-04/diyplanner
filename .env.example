# Subdomain des Backends (DNS-A-Record muss auf den VPS zeigen)
DM_DOMAIN=app.example.de
# Anthropic-API-Key für die KI-Analyse (console.anthropic.com)
ANTHROPIC_API_KEY=
# Domain der WordPress-Seite, die den Editor einbettet (Komma-getrennt)
DM_ALLOWED_ORIGINS=https://www.example.de,https://example.de
# Optional
DM_MAX_UPLOAD_MB=600
DM_RENDER_SAMPLES=64
